<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="healthyRice" x1="0%" y1="100%" x2="50%" y2="0%">
      <stop offset="0%" stop-color="#16a34a" />
      <stop offset="60%" stop-color="#22c55e" />
      <stop offset="100%" stop-color="#4ade80" />
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="#0f172a" />
  <!-- Lush Healthy Rice Canopy -->
  <path d="M 60 280 C 100 180 150 80 200 40 C 210 110 220 200 200 280 Z" fill="url(#healthyRice)" opacity="0.9" />
  <path d="M 120 280 C 180 160 240 70 320 50 C 310 130 280 220 240 280 Z" fill="url(#healthyRice)" opacity="0.85" />
  <path d="M 30 280 C 70 190 120 120 180 80 C 170 160 140 230 100 280 Z" fill="url(#healthyRice)" opacity="0.8" />
  <circle cx="200" cy="40" r="3" fill="#86efac" />
  <text x="20" y="30" font-family="sans-serif" font-size="14" font-weight="bold" fill="#f8fafc">Healthy Rice - Robust Chlorophyll Foliage</text>
  <rect x="20" y="45" width="90" height="22" rx="6" fill="#166534" />
  <text x="30" y="60" font-family="sans-serif" font-size="11" font-weight="bold" fill="#bbf7d0">✓ 100% Healthy</text>
</svg>