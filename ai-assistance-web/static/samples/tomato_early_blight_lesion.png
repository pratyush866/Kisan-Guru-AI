<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <radialGradient id="blightSpot1" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#262626" />
      <stop offset="40%" stop-color="#451a03" />
      <stop offset="75%" stop-color="#78350f" />
      <stop offset="90%" stop-color="#ca8a04" />
      <stop offset="100%" stop-color="#15803d" />
    </radialGradient>
    <radialGradient id="blightSpot2" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#1c1917" />
      <stop offset="50%" stop-color="#713f12" />
      <stop offset="85%" stop-color="#eab308" />
      <stop offset="100%" stop-color="#16a34a" />
    </radialGradient>
  </defs>
  <rect width="400" height="300" fill="#0f172a" />
  <!-- Tomato Leaf -->
  <path d="M 200 270 C 120 250 80 180 70 140 C 90 130 120 150 140 130 C 130 110 90 90 100 60 C 130 70 160 100 180 80 C 180 50 190 20 200 20 C 210 20 220 50 220 80 C 240 100 270 70 300 60 C 310 90 270 110 260 130 C 280 150 310 130 330 140 C 320 180 280 250 200 270 Z" fill="#15803d" stroke="#22c55e" stroke-width="2"/>
  <!-- Leaf Main Vein -->
  <path d="M 200 270 L 200 20" stroke="#86efac" stroke-width="2.5" fill="none" opacity="0.6"/>
  <!-- Concentric Target Rings Lesions (Early Blight) -->
  <circle cx="160" cy="150" r="32" fill="url(#blightSpot1)" opacity="0.95" />
  <circle cx="160" cy="150" r="22" fill="none" stroke="#ca8a04" stroke-width="1.5" opacity="0.8" />
  <circle cx="160" cy="150" r="14" fill="none" stroke="#78350f" stroke-width="1.5" opacity="0.8" />
  <circle cx="160" cy="150" r="6" fill="#1c1917" />
  
  <circle cx="235" cy="180" r="24" fill="url(#blightSpot2)" opacity="0.9" />
  <circle cx="235" cy="180" r="16" fill="none" stroke="#eab308" stroke-width="1.5" opacity="0.8" />
  <circle cx="235" cy="180" r="8" fill="#1c1917" />
  
  <text x="20" y="30" font-family="sans-serif" font-size="14" font-weight="bold" fill="#f8fafc">Tomato Leaf - Early Blight (Alternaria solani)</text>
</svg>