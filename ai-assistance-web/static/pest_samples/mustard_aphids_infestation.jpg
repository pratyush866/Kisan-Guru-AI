<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <rect width="400" height="300" fill="#0f172a" />
  <!-- Mustard Floral Shoot -->
  <path d="M 200 280 L 200 60" stroke="#15803d" stroke-width="10" stroke-linecap="round"/>
  <!-- Mustard Flower Buds -->
  <circle cx="200" cy="50" r="14" fill="#eab308" />
  <circle cx="180" cy="65" r="10" fill="#facc15" />
  <circle cx="220" cy="65" r="10" fill="#facc15" />
  <!-- Clustered Aphid Colony -->
  <g fill="#166534" stroke="#052e16" stroke-width="0.8">
    <ellipse cx="196" cy="100" rx="4" ry="6" />
    <ellipse cx="204" cy="105" rx="3.5" ry="5.5" />
    <ellipse cx="198" cy="115" rx="4" ry="6" />
    <ellipse cx="203" cy="122" rx="4.5" ry="6.5" />
    <ellipse cx="195" cy="130" rx="3.5" ry="5.5" />
    <ellipse cx="205" cy="138" rx="4" ry="6" />
    <ellipse cx="197" cy="148" rx="4" ry="6" />
    <ellipse cx="204" cy="156" rx="4.5" ry="6.5" />
    <ellipse cx="196" cy="165" rx="3.5" ry="5.5" />
    <ellipse cx="202" cy="175" rx="4" ry="6" />
    <ellipse cx="197" cy="188" rx="4" ry="6" />
    <ellipse cx="203" cy="198" rx="4.5" ry="6.5" />
    <!-- Honeydew drops -->
    <circle cx="192" cy="125" r="2.5" fill="#fef08a" opacity="0.8" />
    <circle cx="208" cy="160" r="2.5" fill="#fef08a" opacity="0.8" />
  </g>
  <text x="20" y="30" font-family="sans-serif" font-size="14" font-weight="bold" fill="#f8fafc">Mustard Shoot - Aphid Colony Infestation</text>
</svg>