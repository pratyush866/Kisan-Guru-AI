<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <rect width="400" height="300" fill="#0f172a" />
  <!-- Maize Leaf with chew holes -->
  <path d="M 40 260 C 120 220 250 150 360 80 C 280 130 180 200 40 260 Z" fill="#15803d" stroke="#22c55e" stroke-width="2"/>
  <!-- Chewed Holes -->
  <ellipse cx="160" cy="190" rx="14" ry="10" fill="#0f172a" stroke="#713f12" stroke-width="2" />
  <ellipse cx="210" cy="160" rx="18" ry="12" fill="#0f172a" stroke="#713f12" stroke-width="2" />
  <!-- Fall Armyworm Caterpillar -->
  <g transform="rotate(-30 220 140)">
    <path d="M 170 140 Q 200 130 230 140 Q 260 150 280 140" fill="none" stroke="#78350f" stroke-width="12" stroke-linecap="round"/>
    <path d="M 170 140 Q 200 130 230 140 Q 260 150 280 140" fill="none" stroke="#a16207" stroke-width="8" stroke-linecap="round"/>
    <!-- Head capsule -->
    <circle cx="280" cy="140" r="7" fill="#451a03" />
    <!-- Inverted Y-shape mark on head -->
    <path d="M 278 138 L 282 140 L 285 137 M 282 140 L 282 144" stroke="#fef08a" stroke-width="1.5" fill="none"/>
    <!-- Body segments pins -->
    <circle cx="190" cy="135" r="2" fill="#1c1917"/>
    <circle cx="210" cy="133" r="2" fill="#1c1917"/>
    <circle cx="230" cy="137" r="2" fill="#1c1917"/>
    <circle cx="250" cy="143" r="2" fill="#1c1917"/>
  </g>
  <text x="20" y="30" font-family="sans-serif" font-size="14" font-weight="bold" fill="#f8fafc">Maize - Fall Armyworm (Spodoptera frugiperda)</text>
</svg>